# Server .env. `make install` copies this to .env; fill in every value marked below.
# Values are literal: Docker's env_file does not reliably expand ${OTHER_VAR}.

APP_NAME=Mongkol
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Set: the public https address Nginx Proxy Manager serves.
APP_URL=https://mongkol.example.com

# Set: Nginx Proxy Manager's Docker network (docker network ls). Its proxy host
# forwards to http://mongkol-web:80. Leave empty to publish nginx on APP_PORT instead.
PROXY_NETWORK=
APP_PORT=8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# stderr, so `make logs` shows application errors.
LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=mongkol
DB_USERNAME=mongkol
# Set: two different long random passwords (openssl rand -base64 24).
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
# shortcut: no worker container yet, so jobs run inline; switch to database and add a worker when M6 queues mail.
QUEUE_CONNECTION=sync
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=Mongkol

# Set: from the Google Cloud OAuth client. Add the redirect URI there too.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://mongkol.example.com/auth/google/callback

# Set: comma-separated Google emails allowed into /admin.
ADMIN_EMAILS=

# Telegram alerts to you for new payment proofs (create a bot with @BotFather).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Shown on /privacy, /terms and /refunds.
LEGAL_OPERATOR=Mongkol
CONTACT_EMAIL=
